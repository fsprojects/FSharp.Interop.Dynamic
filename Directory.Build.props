<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RepositoryUrl>https://github.com/fsprojects/FSharp.Interop.Dynamic.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Next release is 6.0.0: net45 and netstandard1.6 were dropped. -->
    <VersionPrefix>6.0.0</VersionPrefix>

    <!-- SDK Roslyn analyzers (CA*). F# has no C# AST, so Roslynator/Sonar C#
         would be silent; these IL-level rules still fire. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- FS1182 is off by default. It is the compiler's unused-binding /
         unused-open check, which is the dead-code signal for F#. -->
    <WarnOn>1182</WarnOn>

    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <!-- Scorecard Pinned-Dependencies counts a restore as pinned only when it
         passes locked-mode, which needs a committed lock file (issue 55). -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The SDK adds its bundled FSharp.Core library-packs folder as a restore
         source. That nupkg hashes differently from nuget.org's, so the lock
         file broke (NU1403) whenever the SDK version changed. Restore from
         nuget.org only. -->
    <_FSharpCoreLibraryPacksFolder>$(MSBuildThisFileDirectory).no-library-packs/</_FSharpCoreLibraryPacksFolder>
  </PropertyGroup>
</Project>
