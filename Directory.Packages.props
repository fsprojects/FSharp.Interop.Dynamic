<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="coverlet.MTP" Version="10.0.1" />
    <PackageVersion Include="Dynamitey" Version="3.0.3" />
    <PackageVersion Include="FSharp.Analyzers.Build" Version="0.5.0" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <!-- FSharp.Core is the library's published dependency floor, so keep it
         low: consumers cannot go below it. The library builds against
         4.7.2; Tests override to a current version (issue 80). -->
    <PackageVersion Include="FSharp.Core" Version="4.7.2" />
    <PackageVersion Include="FsUnit.Xunit" Version="7.1.1" />
    <PackageVersion Include="Ionide.Analyzers" Version="0.19.0" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.analyzers" Version="2.1.0" />
  </ItemGroup>
</Project>
